# Names only — never commit values. Copy to .env.local and fill in.

# Neon Postgres. The pooled URL is what the app uses at runtime.
DATABASE_URL=

# The direct, non-pooled URL. drizzle-kit uses it for migrations and falls back
# to DATABASE_URL when it is absent — which is correct for a local Postgres,
# where there is only one URL.
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth). Both are required: without them `pnpm build`
# fails while collecting page data for /api/auth/[...path], which reads as a
# code error and is not one.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# El tablero: cuántos días una imagen puede estar en las mismas manos antes de que
# la tarjeta «Sin cambiar de manos» la mencione. 180 si no está, y un valor que no
# sea un entero positivo se ignora en lugar de apagar la tarjeta. Es configurable
# porque la Campaña todavía no eligió el número — ver docs/PRODUCTION-PLAN.md.
# TABLERO_DIAS_ESTANCADA=

# Tests do not read this file. They use the throwaway container started by
# `pnpm test:db:up`; override only in CI. See docs/TESTING.md.
# TEST_DATABASE_URL=
